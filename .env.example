# ---- Supabase Postgres: ALL durable state (subscriptions, invoices, quotes, audit log, rate limits) ----
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase → Database settings → SSL → download certificate; paste the PEM contents to verify TLS
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
# Apply supabase/migrations at startup (CI runs `npm run migrate` instead)
AUTO_MIGRATE=false

# ---- Runtime ----
NODE_ENV=production
# Cloud Run injects PORT (8080). Local default is 8080.
PORT=8080
# Public HTTPS origin of this app (used for approval links and Origin checks)
PUBLIC_BASE_URL=https://mcp.example.com
LOG_LEVEL=info
# Cloud Run (and Cloudflare, if used) terminate TLS in front of Node
TRUST_PROXY=true

# ---- Unstoppable Domains Resolution Service (server-side only) ----
UNSTOPPABLE_API_KEY=
UNSTOPPABLE_API_BASE=https://api.unstoppabledomains.com/resolve
# ud-precedence (UD documented order incl. token.EVM.* family records, with warnings) | strict (USDC-specific records only)
RECIPIENT_RECORD_POLICY=ud-precedence

# ---- RPC endpoints (server-side only; a missing URL = network reported as not configured) ----
ETHEREUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
RPC_TIMEOUT_MS=10000

# ---- Native-coin price source (CoinGecko-compatible) ----
PRICE_API_BASE=https://api.coingecko.com/api/v3
PRICE_FEED_API_KEY=
# x-cg-demo-api-key for CoinGecko Demo, x-cg-pro-api-key for Pro (also set PRICE_API_BASE to the pro host)
PRICE_API_KEY_HEADER=x-cg-demo-api-key
PRICE_MAX_AGE_SECONDS=300
PRICE_CACHE_SECONDS=30

# ---- Quotes ----
QUOTE_TTL_SECONDS=120
PREPARATION_TTL_SECONDS=180
MAX_TRANSFER_USDC=10000
GAS_LIMIT_BUFFER_BPS=12000
L1_FEE_BUFFER_BPS=12500

# ---- Security ----
# Comma-separated name:key pairs (each key >= 24 chars). Generate: openssl rand -hex 32
API_KEYS=claude:REPLACE_ME
# HMAC secret binding prepared transactions (>= 32 chars). Generate: openssl rand -hex 32
MCP_AUTH_SECRET=
# Extra browser origins allowed to call the API (PUBLIC_BASE_URL is always allowed)
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_PER_MINUTE=30
REQUEST_BODY_LIMIT=32kb

# ---- Subscription billing: crypto only (USDC) paid to the billing domain's linked wallets ----
BILLING_ENABLED=true
BILLING_DOMAIN=vimatons.dao
# Strongly recommended: pin the wallets you expect, so a changed domain record pauses billing
# instead of redirecting payments. Format: network:address,network:address
BILLING_PINNED_ADDRESSES=
# Optional JSON override of plans (defaults: starter 10, pro 49, business 199 USDC / 30 days)
# BILLING_PLANS=[{"id":"starter","name":"Starter","priceUsdc":"10","periodDays":30,"monthlyCalls":1000}]
BILLING_INVOICE_TTL_SECONDS=3600
