{
  "name": "thomaszacharias-mcp",
  "version": "0.2.0",
  "description": "Web3 domain USDC payment route MCP server (resolve, compare, prepare unsigned, verify)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run && TEST_STORE=pglite vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:memory": "vitest run",
    "test:postgres": "TEST_STORE=pglite vitest run",
    "migrate": "node dist/store/migrate.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "viem": "^2.57.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
